///|
test "render produces a self-contained HTML document with embedded JSON" {
  let dag = @core.Dag::empty("demo")
  dag.add_goal(id="m1", title="用户能登录")
  dag.add_task(id="i1", goal="m1", title="auth middleware")
  dag.update_status("i1", @core.Done)
  let html = @render.render(dag)
  // Basic structural checks — we don't snapshot the whole document because
  // the embedded script is large.
  assert_true(html.contains("<!DOCTYPE html>"))
  assert_true(html.contains("id=\"map-canvas\""))
  assert_true(html.contains("id=\"node-tooltip\""))
  assert_true(html.contains("showNodeTooltip"))
  assert_true(html.contains("id=\"details-panel\""))
  assert_true(html.contains("id=\"overall-progress-bar\""))
  assert_true(html.contains("top-progress"))
  assert_true(html.contains("fitNodeText"))
  assert_true(html.contains("id=\"node-detail-modal\""))
  assert_true(html.contains("role=\"dialog\""))
  assert_true(html.contains("node-modal-backdrop"))
  assert_true(html.contains("nodeDetailsHtml"))
  assert_true(html.contains("openNodeModal"))
  assert_true(html.contains("closeNodeModal"))
  assert_true(html.contains("id=\"task-detail-modal\""))
  assert_true(html.contains("openTaskModal"))
  assert_true(html.contains("closeTaskModal"))
  assert_true(html.contains("taskDetailsHtml"))
  assert_true(html.contains("data-task-id"))
  assert_true(html.contains("linkifyGithub"))
  assert_true(html.contains("isGithubUrl"))
  assert_true(html.contains("gh-link"))
  assert_true(html.contains("dblclick"))
  assert_true(html.contains("node-pending"))
  assert_true(html.contains("idealRowById"))
  assert_true(html.contains("branchStarts"))
  assert_true(html.contains("layoutRow"))
  assert_true(html.contains("skipLevel"))
  assert_true(html.contains("项目进度"))
  assert_true(html.contains("节点详情"))
  assert_true(html.contains("id=\"reset-layout\""))
  assert_true(html.contains("aria-keyshortcuts"))
  assert_true(html.contains("map.reset-layout"))
  assert_true(html.contains("map.node-navigation"))
  assert_true(html.contains("map.sidebar-navigation"))
  assert_true(html.contains("arrowup"))
  assert_true(html.contains("meta+arrowdown"))
  assert_true(html.contains("meta+end"))
  assert_true(html.contains("ArrowRight"))
  assert_true(html.contains("shortcutEventKey"))
  assert_true(html.contains("capture: true"))
  assert_true(html.contains("handleNodeNavigation"))
  assert_true(html.contains("selectFinalGoalNode"))
  assert_false(html.contains("selectSidebarEdgeNode"))
  assert_false(html.contains("event.ctrlKey || event.altKey || event.metaKey"))
  assert_false(html.contains("window.addEventListener('keydown'"))
  assert_true(html.contains("id=\"goal-search\""))
  assert_true(html.contains("id=\"product-filter\""))
  assert_true(html.contains("task-detail-list"))
  assert_true(html.contains("任务详情"))
  assert_false(html.contains("<details class=\"task-detail\" open>"))
  assert_true(html.contains("id=\"dag-data\""))
  assert_true(html.contains("\"goals\""))
  assert_true(html.contains("\"tasks\""))
  assert_true(html.contains("\"closure_tiers\""))
  assert_true(html.contains("\"用户能登录\""))
  assert_true(html.contains("auth middleware"))
  assert_true(html.contains("\"status\": \"done\""))
}
